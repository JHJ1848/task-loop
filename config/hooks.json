{
  "context-injector": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/hooks/inject_session_context.js",
        "timeout": 15
      }
    ]
  },
  "allowlist-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|create_file|edit_file|delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/enforce_allowlist.js",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "session-auto-provisioner": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "send_message",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/resolve_or_create_session.js",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
